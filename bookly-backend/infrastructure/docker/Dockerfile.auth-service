# Dockerfile para Auth Service
FROM node:22-alpine AS base

RUN apk add --no-cache python3 make g++ libc6-compat dumb-init
RUN addgroup -g 1001 -S bookly && adduser -S bookly -u 1001

WORKDIR /app

ENV NODE_ENV=production
ENV PORT=3001
ENV SERVICE_NAME=auth-service

COPY package*.json ./

RUN npm ci

COPY prisma/schema.prisma ./prisma/schema.prisma

COPY . .

# Copiar entrypoint script
COPY infrastructure/scripts/docker-entrypoint.sh /tmp/docker-entrypoint.sh
RUN chmod +x /tmp/docker-entrypoint.sh

RUN npx prisma generate

# No build stage - usando ts-node

FROM node:22-alpine AS production
RUN apk add --no-cache dumb-init su-exec
RUN addgroup -g 1001 -S bookly && adduser -S bookly -u 1001

WORKDIR /app
ENV NODE_ENV=production
ENV PORT=3001
ENV SERVICE_NAME=auth-service

COPY --from=base --chown=bookly:bookly /app/src ./src
COPY --from=base --chown=bookly:bookly /app/node_modules ./node_modules
COPY --from=base --chown=bookly:bookly /app/package.json ./
COPY --from=base --chown=bookly:bookly /app/prisma ./prisma
COPY --from=base --chown=bookly:bookly /app/tsconfig.json ./
COPY --from=base --chown=bookly:bookly /app/nest-cli.json ./

# Copiar entrypoint script desde stage base
COPY --from=base /tmp/docker-entrypoint.sh /usr/local/bin/docker-entrypoint.sh
RUN chmod +x /usr/local/bin/docker-entrypoint.sh
EXPOSE 3001

HEALTHCHECK --interval=30s --timeout=10s --start-period=30s --retries=3 \
  CMD wget --quiet --tries=1 --spider http://localhost:3001/health || exit 1

ENTRYPOINT ["/usr/local/bin/docker-entrypoint.sh"]
CMD ["node", "-r", "ts-node/register", "-r", "tsconfig-paths/register", "src/apps/auth-service/main.ts"]
