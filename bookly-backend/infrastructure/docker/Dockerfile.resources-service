# Dockerfile para Resources Service
FROM node:22-alpine AS base

RUN apk add --no-cache python3 make g++ libc6-compat dumb-init
RUN addgroup -g 1001 -S bookly && adduser -S bookly -u 1001

WORKDIR /app

ENV NODE_ENV=production
ENV PORT=3002
ENV SERVICE_NAME=resources-service
ENV PNPM_HOME="/pnpm"
ENV PATH="$PNPM_HOME:$PATH"

RUN corepack enable && corepack prepare pnpm@latest --activate

COPY package*.json pnpm-lock.yaml* ./
RUN pnpm install --frozen-lockfile --prod=false

COPY . .
RUN pnpm prisma generate

FROM base AS build
RUN pnpm build:resources
RUN pnpm prune --prod

FROM node:22-alpine AS production
RUN apk add --no-cache dumb-init
RUN addgroup -g 1001 -S bookly && adduser -S bookly -u 1001

WORKDIR /app
ENV NODE_ENV=production
ENV PORT=3002
ENV SERVICE_NAME=resources-service

COPY --from=build --chown=bookly:bookly /app/dist ./dist
COPY --from=build --chown=bookly:bookly /app/node_modules ./node_modules
COPY --from=build --chown=bookly:bookly /app/package.json ./
COPY --from=build --chown=bookly:bookly /app/prisma ./prisma

USER bookly
EXPOSE 3002

HEALTHCHECK --interval=30s --timeout=10s --start-period=30s --retries=3 \
  CMD wget --quiet --tries=1 --spider http://localhost:3002/health || exit 1

CMD ["dumb-init", "node", "dist/apps/resources-service/main.js"]
