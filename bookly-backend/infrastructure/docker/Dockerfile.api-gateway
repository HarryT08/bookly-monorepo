# Dockerfile para API Gateway
FROM node:22-alpine AS base

# Instalar dependencias del sistema
RUN apk add --no-cache python3 make g++ libc6-compat dumb-init

# Crear usuario no-root
RUN addgroup -g 1001 -S bookly && adduser -S bookly -u 1001

WORKDIR /app

# Configurar variables de entorno
ENV NODE_ENV=production
ENV PORT=3000
ENV SERVICE_NAME=api-gateway
ENV PNPM_HOME="/pnpm"
ENV PATH="$PNPM_HOME:$PATH"

# Instalar pnpm
RUN corepack enable && corepack prepare pnpm@latest --activate

# Copiar archivos de configuración
COPY package*.json pnpm-lock.yaml* ./

# Instalar dependencias
RUN pnpm install --frozen-lockfile --prod=false

# Copiar código fuente
COPY . .

# Generar cliente Prisma
RUN pnpm prisma generate

# Build para producción
FROM base AS build
RUN pnpm build:api-gateway
RUN pnpm prune --prod

# Imagen final
FROM node:22-alpine AS production
RUN apk add --no-cache dumb-init
RUN addgroup -g 1001 -S bookly && adduser -S bookly -u 1001

WORKDIR /app
ENV NODE_ENV=production
ENV PORT=3000
ENV SERVICE_NAME=api-gateway

# Copiar archivos necesarios
COPY --from=build --chown=bookly:bookly /app/dist ./dist
COPY --from=build --chown=bookly:bookly /app/node_modules ./node_modules
COPY --from=build --chown=bookly:bookly /app/package.json ./
COPY --from=build --chown=bookly:bookly /app/prisma ./prisma

USER bookly
EXPOSE 3000

HEALTHCHECK --interval=30s --timeout=10s --start-period=30s --retries=3 \
  CMD wget --quiet --tries=1 --spider http://localhost:3000/health || exit 1

CMD ["dumb-init", "node", "dist/apps/api-gateway/main.js"]
