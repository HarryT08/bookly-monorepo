# Dockerfile para Stockpile Service
FROM node:22-alpine AS base

RUN apk add --no-cache python3 make g++ libc6-compat dumb-init
RUN addgroup -g 1001 -S bookly && adduser -S bookly -u 1001

WORKDIR /app

ENV NODE_ENV=production
ENV PORT=3004
ENV SERVICE_NAME=stockpile-service

COPY package*.json ./
COPY prisma ./prisma

RUN npm ci --only=production --ignore-scripts

COPY . .
RUN npx prisma generate

FROM base AS build
RUN npm run build
RUN npm prune --production

FROM node:22-alpine AS production
RUN apk add --no-cache dumb-init
RUN addgroup -g 1001 -S bookly && adduser -S bookly -u 1001

WORKDIR /app
ENV NODE_ENV=production
ENV PORT=3004
ENV SERVICE_NAME=stockpile-service

COPY --from=build --chown=bookly:bookly /app/dist ./dist
COPY --from=build --chown=bookly:bookly /app/node_modules ./node_modules
COPY --from=build --chown=bookly:bookly /app/package.json ./
COPY --from=build --chown=bookly:bookly /app/prisma ./prisma

USER bookly
EXPOSE 3004

HEALTHCHECK --interval=30s --timeout=10s --start-period=30s --retries=3 \
  CMD wget --quiet --tries=1 --spider http://localhost:3004/health || exit 1

CMD ["dumb-init", "node", "dist/apps/stockpile-service/main.js"]
