              }
            ],
            "url": {
              "raw": "{{base_url}}/permissions?resource=&action=&scope=&isActive=",
              "host": ["{{base_url}}"],
              "path": ["permissions"],
              "query": [
                {
                  "key": "resource",
                  "value": ""
                },
                {
                  "key": "action",
                  "value": ""
                },
                {
                  "key": "scope",
                  "value": ""
                },
                {
                  "key": "isActive",
