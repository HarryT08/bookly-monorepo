# NextAuth.js Configuration
# Required: Generate a random secret for JWT signing and encryption
# You can generate one using: openssl rand -base64 32
NEXTAUTH_SECRET=your-nextauth-secret-here

# NextAuth.js URL (for production, change to your domain)
NEXTAUTH_URL=http://localhost:3000

# Bookly API Configuration
NEXT_PUBLIC_API_URL=http://localhost:3001/api

# OAuth Providers (optional - configure if using social login)
# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Facebook OAuth  
FACEBOOK_CLIENT_ID=your-facebook-client-id
FACEBOOK_CLIENT_SECRET=your-facebook-client-secret

# Vercel KV (for production storage - optional)
AUTH_KV_REST_API_URL=your-vercel-kv-url
AUTH_KV_REST_API_TOKEN=your-vercel-kv-token

# Database Configuration (if needed)
DATABASE_URL=your-database-url
